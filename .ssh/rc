# Point a fixed path at this login's agent socket so existing shells and tmux panes keep working after reconnects.
if [ -S "$SSH_AUTH_SOCK" ]; then
  ln -sf "$SSH_AUTH_SOCK" "$HOME/.ssh/ssh_auth_sock"
fi

# A ~/.ssh/rc disables sshd's automatic xauth setup, so do it here for X11 forwarding (from sshd(8)).
if read proto cookie && [ -n "$DISPLAY" ]; then
  if [ "$(echo "$DISPLAY" | cut -c1-10)" = 'localhost:' ]; then
    echo add "unix:$(echo "$DISPLAY" | cut -c11-)" "$proto" "$cookie"
  else
    echo add "$DISPLAY" "$proto" "$cookie"
  fi | xauth -q -
fi
