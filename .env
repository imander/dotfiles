export PATH=$PATH:/usr/local/go/bin:/usr/local/bin:$HOME/bin:$HOME/go/bin
export EDITOR=vim
export GOPATH=$HOME/go
export GPG_TTY=$(tty)

if [[ ! $PATH == *.local/bin* ]]; then
  test -s ~/.profile && source ~/.profile || true
fi

# test -f ~/.asdf/asdf.sh && source ~/.asdf/asdf.sh || true
test -s ~/.alias && source ~/.alias || true

if [[ -x "$(command -v rbenv)" ]]; then
  eval "$(rbenv init -)"
fi

if [[ -x "$(command -v pyenv)" ]]; then
  eval "$(pyenv init -)"
fi

# Use the stable agent socket from ~/.ssh/rc so shells survive SSH reconnects.
test -S ~/.ssh/ssh_auth_sock && export SSH_AUTH_SOCK=~/.ssh/ssh_auth_sock

test -s ~/.env.local && source ~/.env.local || true
test -s ~/.cargo/env && source ~/.cargo/env || true

pukeskull
